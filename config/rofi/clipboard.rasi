@import "mocha"
configuration {
    show-icons:                 false;
		location: 5;
}

/*
USE_BUTTONS=YES
*/
* {
	font: "GeistMono NF 10";
}

window {
  x-offset:										 -10px;
  y-offset:										 -10px;
  width:                       10%;
  margin:                      0px;
  padding:                     10px 10px;
  border:                      2px solid;
  border-color:		 						 @lavender;
  background-color:            @base;
  children: 			 		 				 [ "message", "listview" ];
}

message {
  padding:                     5px 0;
  margin:                      0 0 10px 0;
  background-color:            transparent;
  text-color:					         @lavender;
  font-weight:				 			   bold;
  border:						   				 0px 0px 1px solid;
  border-color:				 			   @lavender;
}

textbox {
  background-color:            inherit;
  text-color:                  inherit;
  horizontal-align:            0.5;
}

listview {
  enabled:                     true;
  columns:                     1;
  lines:                       2;
  layout:                      vertical;
  background-color:	 	 	  		 transparent;
}

element {
  padding:					 					 10px;
  border-color:                @lavender;
  background-color:            @base;
  text-color:                  @text;
  cursor:                      pointer;
}
element-icon {
    background-color:          @base;
    size:                      80px;
    margin: 			         		 0 10px 0 0;
}
element-icon.selected {
    background-color:          @crust;
}
element selected.normal {
	border: 					 					 1px solid;
  background-color:            @crust;
  text-color:                  @lavender;
}
element-text {
  background-color:            transparent;
  text-color:                  inherit;
  cursor:                      inherit;
  vertical-align:              0.5;
}
