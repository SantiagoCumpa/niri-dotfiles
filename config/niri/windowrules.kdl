// https://yalter.github.io/niri/Configuration:-Window-Rules
window-rule {
	match app-id="tui"
	open-floating true
	default-column-width { fixed 600; }
	default-window-height { fixed 800; }
}
window-rule {
	match app-id="fm"
	open-floating true
	opacity 0.95
	default-column-width { fixed 1400; }
	default-window-height { fixed 800; }
}
window-rule {
    match is-window-cast-target=true
    border {
        on
        width 2
        active-color "#74c7ec"
        inactive-color "#82A4B3"
    }
    shadow {
        on
        spread 0.75
        softness 20
        color "#74c7ec"
        inactive-color "#82A4B3"
    }
    tab-indicator {
        active-color "#74c7ec"
        inactive-color "#82A4B3"
    }
}
