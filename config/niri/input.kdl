// h// https://yalter.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // layout "latam"
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.5
    }

    mouse {
        accel-speed 0
    }
}
