include "autostart.kdl"
include "input.kdl"
include "outputs.kdl"
include "keybinds.kdl"
include "windowrules.kdl"
include "layout.kdl"
include "overview.kdl"
include "env.kdl"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

// You can also set this to null to disable saving screenshots to disk.
screenshot-path "/tmp/screenshot.png"
// screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

xwayland-satellite {
	// off
  path "xwayland-satellite"
}

